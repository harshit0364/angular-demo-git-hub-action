/***
  Configuration for Angular Static Web App
  Handles routing and security
 ***/

{
  "routes": [
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "*.{css,scss,gif,ico,jpg,jpeg,js,map,png,svg,webp}"
    ]
  },
  "responseOverrides": {
    "401": {
      "rewrite": "/404.html",
      "statusCode": 404
    },
    "403": {
      "rewrite": "/404.html",
      "statusCode": 404
    },
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": [
    {
      "path": "/*",
      "headers": {
        "Cache-Control": "public, max-age=3600",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    }
  ],
  "mimeTypes": {
    ".json": "text/json"
  }
}
